# ==============================================================================
# GESTOR ACADÉMICO VIRTUAL - DOCKERFILE FRONTEND (REACT 19 + VITE + NGINX)
# ==============================================================================

FROM nginx:1.27-alpine AS runner

# Copiar configuración con soporte SPA y proxy reverso
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copiar bundle optimizado de producción
COPY frontend/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
