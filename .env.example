# ==============================================================================
# GESTOR ACADÉMICO VIRTUAL - VARIABLES DE ENTORNO
# Archivo de plantilla .env.example
#
# Copiar a .env y reemplazar TODOS los valores marcados como CAMBIAR_*.
# En producción usar SPRING_PROFILES_ACTIVE=prod y secretos propios.
# ==============================================================================

# Configuración de Base de Datos MySQL
MYSQL_DATABASE=gestoracad_db
MYSQL_USER=gestor_user
MYSQL_PASSWORD=CAMBIAR_CONTRASENA_USUARIO
MYSQL_ROOT_PASSWORD=CAMBIAR_CONTRASENA_ROOT
MYSQL_PORT=3310

# Configuración de phpMyAdmin
PHPMYADMIN_PORT=8095

# Configuración del Backend Spring Boot
BACKEND_PORT=8094
SPRING_PROFILES_ACTIVE=dev

# Seguridad y Criptografía JWT
# Generar con: openssl rand -base64 48
JWT_SECRET_KEY=CAMBIAR_SECRETO_JWT_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Configuración de CORS (en producción solo dominios exactos, sin comodines)
CORS_ALLOWED_ORIGINS=http://localhost:3010,http://127.0.0.1:3010,http://localhost:5173,http://127.0.0.1:5173

# Asistente académico
# local = búsqueda local; gpt/rag = GPT con contexto local y fallback a local
ASSISTANT_MODE=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ASSISTANT_MAX_TOKENS=800
ASSISTANT_TEMPERATURE=0.2

# Tiempos de espera del cliente HTTP hacia el proveedor GPT
HTTP_CLIENT_CONNECT_TIMEOUT=5s
HTTP_CLIENT_READ_TIMEOUT=30s

# Configuración del Frontend React
FRONTEND_PORT=3010
